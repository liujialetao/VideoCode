              },\n    51|            ) as response:\n    52|                async for line in response.aiter_lines():\n    53|                    logger.log(line)\n    54|                    yield f\"{line}\\n\"\n    55|\n    56|    return StreamingResponse(event_stream(), media_type=\"text/event-stream\")\n    57|\n    58|\n    59|if __name__ == \"__main__\":\n    60|    import uvicorn\n    61|\n    62|    uvicorn.run(app, host=\"0.0.0.0\", port=8000)\n    63|"
