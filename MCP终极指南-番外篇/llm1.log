          "text": "     1|import json\n     2|\n     3|import httpx\n     4|from fastapi import FastAPI, Request\n     5|from starlette.responses import StreamingResponse\n     6|\n     7|\n     8|class AppLogger:\n     9|    def __init__(self, log_file=\"llm.log\"):\n    10|        \"\"\"Initialize the logger with a file that will be cleared on startup.\"\"\"\n    11|        self.log_file = log_file\n    12|        # Clear the log file on startup\n    13|        with open(self.log_file, 'w') as f:\n    14|            f.write(\"\")\n    15|\n    16|    def log(self, message):\n    17|        \"\"\"Log a message to both file and console.\"\"\"\n    18|\n    19|        # Log to file\n    20|        with open(self.log_file, 'a') as f:\n    21|            f.write(message + \"\\n\")\n    22|\n    23|        # Log to console\n    24|        print(message)\n    25|\n    26|\n    27|app = FastAPI(title=\"LLM API Logger\")\n    28|logger = AppLogger(\"llm.log\")\n    29|\n    30|\n    31|@app.post(\"/v1/chat/completions\")\n    32|@app.post(\"/chat/completions\")\n    33|async def proxy_request(request: Request):\n    34|    body_bytes = await request.body()\n    35|    body = json.loads(body_bytes.decode('utf-8'))\n    36|    logger.log(\"模型请求：\\n\" + json.dumps(body, ensure_ascii=False, indent=2))\n    37|\n    38|    logger.log(\"模型返回：\\n\")\n    39|\n    40|    async def event_stream():\n    41|        async with httpx.AsyncClient(timeout=None) as client:\n    42|            async with client.stream(\n    43|                    \"POST\",\n    44|                    \"https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions\",\n    45|                    json=body,\n    46|                    headers={\n    47|                        \"Content-Type\": \"application/json\",\n    48|                        \"Accept\": \"text/event-stream\",\n    49|                        \"Authorization\": request.headers.get(\"Authorization\"),\n    50|                    },\n  