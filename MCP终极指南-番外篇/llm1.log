          "text": "import httpx\nfrom fastapi import FastAPI, Request\nfrom starlette.responses import StreamingResponse\n\n\nclass AppLogger:\n    def __init__(self, log_file=\"llm.log\"):\n        \"\"\"Initialize the logger with a file that will be cleared on startup.\"\"\"\n        self.log_file = log_file\n    10|        # Clear the log file on startup\n        with open(self.log_file, 'w') as f:\n            f.write(\"\")\n\n    def log(self, message):\n        \"\"\"Log a message to both file and console.\"\"\"\n\n        # Log to file\n        with open(self.log_file, 'a') as f:\n            f.write(message + \"\\n\")\n    20|\n        # Log to console\n        print(message)\n\n\napp = FastAPI(title=\"LLM API Logger\")\nlogger = AppLogger(\"llm.log\")\n\n\n@app.post(\"/v1/chat/completions\")\n    30|@app.post(\"/chat/completions\")\nasync def proxy_request(request: Request):\n    print(\"enter MCP终极指南-番外篇/llm_logger.py:30\")\n    body_bytes = await request.body()\n    body_str = body_bytes.decode('utf-8')\n    logger.log(f\"模型请求：{body_str}\")\n    body = await request.json()\n\n    logger.log(\"模型返回：\\n\")\n\n    40|    async def event_stream():\n        async with httpx.AsyncClient(timeout=None) as client:\n            async with client.stream(\n                    \"POST\",\n                    \"https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions\",\n                    json=body,\n                    headers={\n                        \"Content-Type\": \"application/json\",\n                        \"Accept\": \"text/event-stream\",\n                        \"Authorization\": request.headers.get(\"Authorization\"),\n    50|                    },\n            ) as response:\n                async for line in response.aiter_lines():\n                    logger.log(line)\n                    yield f\"{line}\\n\"\n\n    return StreamingResponse(event_stream(), media_type=\"text/event-stream\")\n\n\nif __name__ == \"__main__\":\n    60|    imp